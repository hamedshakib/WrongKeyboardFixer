<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WrongKeyboardFixer.UI.Controls"
             xmlns:vm="clr-namespace:WrongKeyboardFixer.ViewModels"
             x:Class="WrongKeyboardFixer.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{OnPlatform Android={AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColor}}"
             Title="{Binding Title}">

    <Grid Padding="14" RowDefinitions="Auto,*">

        <!-- Title Bar -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColor}}"
                Padding="16,12"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*">
                <Border.GestureRecognizers>
                    <PanGestureRecognizer />
                </Border.GestureRecognizers>

                <controls:RoundedFrame Grid.Column="0"
                                       BackgroundColor="Transparent"
                                       Padding="0"
                                       StrokeThickness="0"
                                       WidthRequest="12"
                                       HeightRequest="12"
                                       CornerRadius="6"
                                       IsClippedToBounds="True"
                                       Margin="0,0,12,0">
                    <Ellipse Fill="{StaticResource AccentColor}" WidthRequest="10" HeightRequest="10" />
                </controls:RoundedFrame>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding SettingsTitle}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimaryColor}" />
                    <Label Text="{Binding SettingsSubtitle}"
                           FontSize="12.5"
                           TextColor="{StaticResource TextSecondaryColor}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1" Margin="0,10,0,0">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColor}}"
                    CornerRadius="14"
                    Padding="24"
                    StrokeThickness="0"
                    Margin="0">

                <VerticalStackLayout Spacing="0">

                    <!-- Language Section -->
                    <Label Text="{Binding LanguageLabel}"
                           FontSize="14.5"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AccentColor}"
                           Margin="0,0,0,10" />

                    <controls:ModernPicker x:Name="LanguagePicker"
                                            Items="{Binding LanguageItems}"
                                            SelectedIndex="{Binding LanguageIndex}"
                                            WidthRequest="170"
                                            HorizontalOptions="Start"
                                            Margin="0,0,0,14" />

                    <controls:ToggleSwitch IsToggled="{Binding RunOnStartup}"
                                           ToggleLabel="{Binding RunOnStartupLabel}"
                                           WidthRequest="260"
                                           HorizontalOptions="Start"
                                           Margin="0,0,0,0" />

                    <!-- Divider -->
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,22,0,0" />

                    <!-- Hotkey Section -->
                    <Label Text="{Binding HotkeyGroupLabel}"
                           FontSize="14.5"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AccentColor}"
                           Margin="0,22,0,10" />

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" Margin="0,0,0,14">
                        <controls:ModernPicker x:Name="ModifierPicker"
                                                Grid.Column="0"
                                                Items="{Binding ModifierItems}"
                                                SelectedIndex="{Binding HotkeyModifierIndex}"
                                                WidthRequest="160"
                                                HorizontalOptions="Start" />
                        <Label Grid.Column="1"
                               Text="+"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimaryColor}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               WidthRequest="24" />
                        <controls:ModernPicker x:Name="KeyPicker"
                                                Grid.Column="2"
                                                Items="{Binding KeyItems}"
                                                SelectedIndex="{Binding HotkeyKeyIndex}"
                                                WidthRequest="130"
                                                HorizontalOptions="Start" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
                        <controls:ModernButton Grid.Column="0"
                                                Text="{Binding ApplyHotkeyLabel}"
                                                ButtonVariant="Primary"
                                                WidthRequest="150"
                                                HorizontalOptions="Start"
                                                Command="{Binding OnModifierChangedCommand}" />
                        <controls:StatusChip Grid.Column="1"
                                              StatusText="{Binding StatusText}"
                                              ChipTextColor="{Binding StatusColor}"
                                              ChipBackgroundColor="{Binding StatusBgColor}"
                                              HorizontalOptions="Start"
                                              Margin="12,0,0,0" />
                    </Grid>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,0,0,0" />

                    <!-- Keyboard Mappings Section -->
                    <Label Text="{Binding KeyboardMappingsLabel}"
                           FontSize="14.5"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AccentColor}"
                           Margin="0,22,0,10" />

                    <controls:ModernButton Text="{Binding KeyboardMappingsLabel}"
                                            ButtonVariant="Secondary"
                                            WidthRequest="240"
                                            HorizontalOptions="Start"
                                            Command="{Binding OpenKeyboardMappingsCommand}"
                                            Margin="0,0,0,22" />

                    <!-- Divider -->
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,0,0,0" />

                    <!-- Version Section -->
                    <Label Text="{Binding CurrentVersionLabel}"
                           FontSize="14.5"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AccentColor}"
                           Margin="0,22,0,10" />

                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,22">
                        <Label Grid.Column="0"
                               Text="{Binding CurrentVersionLabel}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource AccentColor}"
                               VerticalOptions="Center"
                               WidthRequest="140" />
                        <controls:ModernButton Grid.Column="1"
                                                Text="{Binding CheckUpdateLabel}"
                                                ButtonVariant="Secondary"
                                                WidthRequest="170"
                                                HorizontalOptions="Start"
                                                Margin="12,0,0,0" />
                    </Grid>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,0,0,0" />

                    <!-- Footer Buttons -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,22,0,0" ColumnSpacing="12">
                        <controls:ModernButton Grid.Column="1"
                                                Text="{Binding SaveLabel}"
                                                ButtonVariant="Primary"
                                                WidthRequest="112"
                                                Command="{Binding SaveCommand}" />
                        <controls:ModernButton Grid.Column="2"
                                                Text="{Binding CancelLabel}"
                                                ButtonVariant="Secondary"
                                                WidthRequest="112"
                                                Command="{Binding CancelCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </ScrollView>

    </Grid>

</ContentPage>
