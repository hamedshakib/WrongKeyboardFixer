<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-windows</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>WrongKeyboardFixer</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- App Identifier -->
		<ApplicationTitle>Wrong Keyboard Fixer</ApplicationTitle>
		<ApplicationId>com.hamedshakib.wrongkeyboardfixer</ApplicationId>
		<ApplicationDisplayVersion>2.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Windows -->
		<WindowsSdkPackageVersion>10.0.19041.1706</WindowsSdkPackageVersion>
		<WindowsPackageType>MSIX</WindowsPackageType>
		<AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>

		<!-- Native AOT -->
		<PublishAot>true</PublishAot>
		<StripSymbols>true</StripSymbols>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<InvariantGlobalization>false</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\appicon.svg" ForegroundFile="Resources\appiconfg.svg" Color="#3B69F5" WindowsCondition="'$(TargetFramework)'=='net10.0-windows'" />
		<MauiSplashScreen Include="Resources\splash.svg" Color="#3B69F5" BaseSize="128,128" WindowsCondition="'$(TargetFramework)'=='net10.0-windows'" />
		<MauiImage Include="Resources\Images\*" WindowsCondition="'$(TargetFramework)'=='net10.0-windows'" />
		<MauiFont Include="Resources\Fonts\*" WindowsCondition="'$(TargetFramework)'=='net10.0-windows'" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" WindowsCondition="'$(TargetFramework)'=='net10.0-windows'" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="10.*" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Core\Models\word-corrections.txt">
			<LogicalName>WrongKeyboardFixer.Core.Models.word-corrections.txt</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Resources\Images\WrongKeyboardFixer.ico" />
	</ItemGroup>

</Project>
